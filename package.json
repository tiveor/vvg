{
  "name": "@tiveor/vvg",
  "version": "1.0.3",
  "description": "Every word is a painting. Seeded generative art for the browser, Node and the command line — zero dependencies, SVG or PNG.",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "unpkg": "dist/index.global.js",
  "jsdelivr": "dist/index.global.js",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "vvg": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup && node scripts/copy-web.mjs && node scripts/build-cli.mjs",
    "dev": "tsup --watch",
    "web": "pnpm build && node scripts/serve.mjs",
    "gallery": "pnpm build && node scripts/gallery.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm typecheck && pnpm test && pnpm build",
    "publish:all": "pnpm publish --access public && npm publish ./cli --access public",
    "publish:site": "scripts/publish-site.sh"
  },
  "keywords": [
    "generative-art",
    "generative",
    "art",
    "procedural",
    "seed",
    "seeded",
    "svg",
    "canvas",
    "wallpaper",
    "avatar",
    "identicon",
    "flow-field",
    "bauhaus",
    "creative-coding",
    "cli"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tiveor/vvg.git"
  },
  "author": "Alvaro Orellana",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/tiveor/vvg/issues"
  },
  "homepage": "https://alvarotech.dev/vvg",
  "peerDependencies": {
    "canvas": "^2.11.0 || ^3.0.0"
  },
  "peerDependenciesMeta": {
    "canvas": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "canvas": "^3.2.1",
    "tsup": "^9.0.0",
    "typescript": "^6.0.3",
    "vitest": "^5.1.1"
  },
  "packageManager": "pnpm@12.4.1"
}
