{
  "name": "@tiveor/vvg",
  "version": "0.2.0",
  "description": "A Random Painter - Generative art library using Canvas API",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "node test.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tiveor/vvg.git"
  },
  "author": "Alvaro Orellana",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/tiveor/vvg/issues"
  },
  "homepage": "https://github.com/tiveor/vvg#readme",
  "dependencies": {
    "canvas": "^3.2.1"
  },
  "devDependencies": {
    "@types/node": "^25.3.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  }
}
